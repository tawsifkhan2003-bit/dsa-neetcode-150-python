def groupAnagrams(self, strs):
        """
        :type strs: List[str]
        :rtype: List[List[str]]
        """
        d = defaultdict(list)
        for a, i in enumerate(strs):
            x = "".join(sorted(i))
            if x in d:
                continue
            for j in range(a, len(strs)):
                z = "".join(sorted(strs[j]))
                if x == z:
                    d[x].append(strs[j])
        return list(d.values())//time-comp prob = n^2.k, we can n.k
