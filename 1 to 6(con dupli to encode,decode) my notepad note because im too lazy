class Solution(object):
    def topKFrequent(self, nums, k):
        """
        :type nums: List[int]
        :type k: int
        :rtype: List[int]
        """
        c = Counter(nums)
        b = [[] for _ in range(len(nums) + 1)]
        for i, x in c.items():
            b[x].append(i)
        res = []
        for i in range(len(b)-1, -1, -1):
            res.extend(b[i])
            if len(res) >= k:
                break
        return res[:k]

