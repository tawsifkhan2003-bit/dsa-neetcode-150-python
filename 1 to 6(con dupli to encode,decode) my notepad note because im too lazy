class Solution:
    def encode(self, strs: List[str]) -> str:
        s = "".join(f"{len(x)}#{x}" for x in strs)
        return s
    def decode(self, s: str) -> List[str]:
        i = 0
        dig = ""
        res = []
        while(i<len(s)):
            while(s[i] != "#"):
                dig += s[i]
                i += 1
            i += 1
            res.append(s[i : i + int(dig)])
            i += int(dig)
            dig = ""
        return res
