from collections import defaultdict//not needed in lc
class Solution(object):
    def groupAnagrams(self, strs):
        """
        :type strs: List[str]
        :rtype: List[List[str]]
        """
        d = defaultdict(list)
        for i in strs:
            x = "".join(sorted(i))
            d[x].append(i)
        return list(d.values())

